<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                        http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
	version="3.1">
	<servlet>
		<servlet-name>LoginServlet</servlet-name>
		<servlet-class>com.loanmanagement.servlet.LoginServlet</servlet-class>

	</servlet>
	<servlet-mapping>
		<servlet-name>LoginServlet</servlet-name>
		<url-pattern>/api/login</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>CustomerServlet</servlet-name>
		<servlet-class>com.loanmanagement.servlet.CustomerServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>CustomerServlet</servlet-name>
		<url-pattern>/customer</url-pattern>
	</servlet-mapping>
	<servlet>
		<servlet-name>LoanServlet</servlet-name>
		<servlet-class>com.loanmanagement.servlet.LoanServlet</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>LoanServlet</servlet-name>
		<url-pattern>/loan</url-pattern>
	</servlet-mapping>



</web-app>
